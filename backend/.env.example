# Thread Backend Environment Configuration

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/thread

# Security Secrets
JWT_SECRET=change-me-please-use-a-long-random-secret-32+chars
ADMIN_PASSWORD=admin123
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Twilio Verify SMS Service Configuration (Required for Real Phone SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Email Configuration (Optional / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# Server Port
PORT=8080
